# Server & Environment
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production-prepkit

# Database (Optional in dev: automatically falls back to in-memory MongoDB if not set)
MONGODB_URI=mongodb://localhost:27017/trao_interview_prep

# LLM Provider Configuration
# Supported providers: "gemini" | "groq" | "mock"
# Default is "gemini", falls back to "mock" if no key is provided
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Alternative ultra-fast free tier at https://console.groq.com/)
GROQ_API_KEY=

# Crawler & Security
# Set to "true" to allow crawling localhost/private IP addresses (default true for local testing & batch evaluate)
ALLOW_LOCAL_URLS=true
CRAWLER_TIMEOUT_MS=8000
MAX_CRAWL_PAGES=4
